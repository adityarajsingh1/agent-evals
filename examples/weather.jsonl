# A tiny dataset for a weather agent. One JSON object per line.
{"id": "berlin-now", "input": "What's the weather in Berlin right now?", "expected_tools": [{"name": "get_weather", "arguments": {"city": "Berlin"}}], "max_steps": 4, "tags": ["weather"]}
